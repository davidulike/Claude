//@version=6
// RSI(2) dip-buy (Larry Connors' well-known short-term pullback rules), long only:
//   - Only trade when price is above its 200 SMA (long-term uptrend).
//   - Buy when the 2-period RSI closes below 10 (a sharp short-term dip).
//   - Sell on the first close above the 5 SMA (the bounce).
// Tested in research/compare_strategies.py: about 37% losing trades vs about 76% for the SMA 50 cross,
// and it made money on all 7 markets tested, but it made LESS than simply buying and holding.
// It's out of the market most of the time. Past results do not predict future results.
strategy("Webhook Bot - RSI(2) Dip", overlay = true,
     initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 100,
     commission_type = strategy.commission.percent, commission_value = 0.1, slippage = 2,
     process_orders_on_close = true)

secret   = input.string("PASTE_YOUR_WEBHOOK_SECRET", "Webhook secret (must match WEBHOOK_SECRET)")
trendLen = input.int(200, "Trend SMA length", minval = 2)
rsiLen   = input.int(2, "RSI length", minval = 2)
rsiBuy   = input.float(10, "Buy when RSI below", minval = 1, maxval = 50)
exitLen  = input.int(5, "Sell on close above SMA of length", minval = 2)
useStop  = input.bool(false, "Use % stop-loss (made results worse in testing)")
stopPct  = input.float(10, "Stop-loss % below entry", minval = 0.5, maxval = 50, step = 0.5)

trend = ta.sma(close, trendLen)
quick = ta.sma(close, exitLen)
r     = ta.rsi(close, rsiLen)
plot(trend, "Trend SMA", color.purple, 2)
plot(quick, "Exit SMA", color.gray)

msg(action, stopPx) =>
    stopPart = na(stopPx) ? "" : ',"stop":' + str.tostring(stopPx)
    '{"secret":"' + secret + '","symbol":"' + syminfo.ticker + '","action":"' + action +
     '","price":' + str.tostring(close) + stopPart + ',"signal_id":"' + syminfo.ticker + '-' + action + '-' +
     str.tostring(time) + '"}'

longEntry = close > trend and r < rsiBuy and barstate.isconfirmed
longExit  = close > quick and barstate.isconfirmed

if longEntry and strategy.position_size == 0
    strategy.entry("Long", strategy.long, alert_message = msg("buy", useStop ? close * (1 - stopPct / 100) : na))

if useStop and strategy.position_size > 0
    strategy.exit("Stop", "Long", stop = strategy.position_avg_price * (1 - stopPct / 100), alert_message = msg("close", na))

if longExit and strategy.position_size > 0
    strategy.close("Long", comment = "Close above exit SMA", alert_message = msg("close", na))
