# Copy to .env and fill in. NEVER commit .env.

# Shared secret that must appear in every TradingView alert message.
# Use a long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
WEBHOOK_SECRET=change-me

# "paper" = built-in simulator (no real money, no account needed)
# "alpaca" = Alpaca brokerage (paper or live, see ALPACA_PAPER)
BROKER=paper

ALPACA_API_KEY=
ALPACA_API_SECRET=
# Keep "true" until you have watched the bot on paper for weeks.
ALPACA_PAPER=true

# Master switch. When false, signals are logged but no orders are sent.
TRADING_ENABLED=true

# Risk limits
ALLOWED_SYMBOLS=SPY,QQQ,AAPL
MAX_POSITION_USD=1000
MAX_DAILY_LOSS_USD=100
MAX_TRADES_PER_DAY=10

# Starting cash for the built-in paper simulator
PAPER_STARTING_CASH=10000

JOURNAL_PATH=journal/trades.jsonl
